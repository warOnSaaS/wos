{
  "name": "@waronsaas/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations/*": "./migrations/*",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "migrate": "node dist/cli.js",
    "migrate:check": "node dist/cli.js --check"
  },
  "dependencies": {
    "@waronsaas/contracts": "*",
    "postgres": "^3.4.9"
  }
}
