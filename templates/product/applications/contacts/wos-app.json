{
  "protocol": "wos-app/v1",
  "app": {
    "id": "contacts",
    "name": "wOS Contacts",
    "version": "0.1.0",
    "kind": "module",
    "billing": "free",
    "summary": "The shared people-and-companies module that CRM, Helpdesk and Marketing require. Never enabled on its own: active while an app that needs it is."
  },
  "requires": { "wos": "^0.1.0", "apps": [] },
  "provides": [],
  "features": [],
  "replaces": [],
  "surfaces": {
    "web": { "supported": false },
    "desktop": { "supported": false },
    "ios": { "supported": false },
    "android": { "supported": false },
    "api": { "supported": true }
  },
  "mobile": null,
  "data": { "schema": "app_contacts", "migrations": null, "owns": [] },
  "permissions": [
    {
      "key": "contacts.status.read",
      "description": "See which Contacts features this version ships",
      "grantedTo": ["owner", "admin", "member"]
    }
  ],
  "events": { "publishes": [], "consumes": [] },
  "routes": { "ui": "/contacts", "api": "/apps/contacts" },
  "navigation": [],
  "hosting": { "selfHost": { "supported": true, "services": ["postgres"] }, "hosted": { "supported": true } }
}
