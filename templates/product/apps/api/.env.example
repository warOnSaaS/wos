# Copy to .env for docker compose. Never commit .env.
POSTGRES_PASSWORD=
# 32+ random characters each, e.g. `openssl rand -base64 36`
WOS_CORE_SECRET=
WOS_WEB_SESSION_SECRET=
# The first owner; other addresses (exact or *@your-company.com) may sign in as members.
WOS_OWNER_EMAIL=
WOS_ALLOWED_EMAILS=
# Apps this environment runs: crm (contacts follows because CRM requires it).
WOS_APPS=crm
WOS_ENVIRONMENT_NAME=Self-hosted wOS
WOS_ORG_NAME=Organization
WOS_PUBLIC_URL=http://localhost:8080
WOS_WEB_PUBLIC_URL=http://localhost:3000
