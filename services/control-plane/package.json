{
  "name": "@waronsaas/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-harness": {
      "types": "./dist/test-harness.d.ts",
      "default": "./dist/test-harness.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --target=node22 --outfile=bundle/index.mjs \"--banner:js=import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" && mkdir -p public && printf 'User-agent: *\\nDisallow: /\\n' > public/robots.txt"
  },
  "dependencies": {
    "@waronsaas/contracts": "*",
    "@waronsaas/db": "*",
    "@waronsaas/agent-policy": "*",
    "@waronsaas/context-engine": "*",
    "@waronsaas/verification": "*",
    "@waronsaas/github": "*",
    "@waronsaas/planning": "*",
    "@waronsaas/rewards": "*",
    "hono": "^4.13.11",
    "postgres": "^3.4.9"
  }
}
