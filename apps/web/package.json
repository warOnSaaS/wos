{
  "name": "@waronsaas/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-shared.mjs && next build && node scripts/check-casing.mjs && node scripts/check-numbers.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:casing": "node scripts/check-casing.mjs",
    "check:numbers": "node scripts/check-numbers.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check"
  },
  "dependencies": {
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
