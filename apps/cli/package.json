{
  "name": "@waronsaas/cli",
  "version": "0.0.0",
  "description": "wOS CLI: build warOnSaaS with your own Claude Code and Codex CLIs.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "wos": "./dist/wos.mjs"
  },
  "files": [
    "dist/wos.mjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "npm run build && npm run bundle"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "@napi-rs/keyring": "^2.1.0",
    "zod": "^4.6.5",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@waronsaas/contracts": "*",
    "@waronsaas/orchestrator": "*"
  }
}
